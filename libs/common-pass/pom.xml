<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mitpass</groupId>
        <artifactId>mitpass-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-pass</artifactId>
    <name>MITPass :: Common Pass</name>
    <description>Pass numbers and the pass-token contract (docs/DECISIONS.md D12): shared by the signer (pass-service) and the scanners (checkin-service)</description>

    <!--
        A plain library jar with no Spring wiring. Nimbus JOSE comes through spring-security-oauth2-jose, whose
        version the Boot BOM manages (don't pin Nimbus separately: phase-4 plan §18 gotcha 5).
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
